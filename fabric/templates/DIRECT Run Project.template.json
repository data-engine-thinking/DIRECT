{
  "properties": {
    "description": "Runs a DIRECT project Batch and its child Batches in sequence: opens the project Batch Instance, runs the project Batch's own Modules, runs every active child Batch (open, run, close) with the project Batch Instance as parent, and closes the project Batch Instance as Failure when any child failed. Standard DIRECT asset; configure through the DIRECT Variable Library.",
    "concurrency": 1,
    "parameters": {
      "BatchCode": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "libraryVariables": {
      "WorkspaceId": {
        "type": "String",
        "variableName": "WorkspaceId",
        "libraryName": "DIRECT"
      },
      "RepositoryDatabaseItemId": {
        "type": "String",
        "variableName": "RepositoryDatabaseItemId",
        "libraryName": "DIRECT"
      },
      "RepositoryConnectionId": {
        "type": "String",
        "variableName": "RepositoryConnectionId",
        "libraryName": "DIRECT"
      },
      "WarehouseItemId": {
        "type": "String",
        "variableName": "WarehouseItemId",
        "libraryName": "DIRECT"
      },
      "WarehouseEndpoint": {
        "type": "String",
        "variableName": "WarehouseEndpoint",
        "libraryName": "DIRECT"
      },
      "WarehouseConnectionId": {
        "type": "String",
        "variableName": "WarehouseConnectionId",
        "libraryName": "DIRECT"
      },
      "ModuleInstanceIdColumnName": {
        "type": "String",
        "variableName": "ModuleInstanceIdColumnName",
        "libraryName": "DIRECT"
      },
      "DefaultStartValue": {
        "type": "String",
        "variableName": "DefaultStartValue",
        "libraryName": "DIRECT"
      },
      "ConsistencyModuleTypeList": {
        "type": "String",
        "variableName": "ConsistencyModuleTypeList",
        "libraryName": "DIRECT"
      },
      "SourceTimestampColumn": {
        "type": "String",
        "variableName": "SourceTimestampColumn",
        "libraryName": "DIRECT"
      },
      "LoadWindowAttributeName": {
        "type": "String",
        "variableName": "LoadWindowAttributeName",
        "libraryName": "DIRECT"
      }
    },
    "activities": [
      {
        "name": "Open Project Batch",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "connectionSettings": {
          "name": "DIRECT repository",
          "properties": {
            "annotations": [],
            "type": "FabricSqlDatabase",
            "typeProperties": {
              "workspaceId": {
                "value": "@pipeline().libraryVariables.WorkspaceId",
                "type": "Expression"
              },
              "artifactId": {
                "value": "@pipeline().libraryVariables.RepositoryDatabaseItemId",
                "type": "Expression"
              }
            },
            "externalReferences": {
              "connection": {
                "value": "@pipeline().libraryVariables.RepositoryConnectionId",
                "type": "Expression"
              }
            }
          }
        },
        "typeProperties": {
          "scriptBlockExecutionTimeout": "02:00:00",
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "{{sql:open-batch.sql}}",
                "type": "Expression"
              },
              "parameters": [
                {
                  "name": "BatchCode",
                  "type": "String",
                  "size": "500",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().parameters.BatchCode",
                    "type": "Expression"
                  }
                },
                {
                  "name": "ParentBatchInstanceId",
                  "type": "String",
                  "size": "100",
                  "direction": "Input",
                  "value": {
                    "value": "@string('0')",
                    "type": "Expression"
                  }
                },
                {
                  "name": "ExecutionContext",
                  "type": "String",
                  "size": "4000",
                  "direction": "Input",
                  "value": {
                    "value": "@concat('Fabric pipeline run ', pipeline().RunId, ' of ', pipeline().Pipeline)",
                    "type": "Expression"
                  }
                },
                {
                  "name": "ModuleInstanceIdColumnName",
                  "type": "String",
                  "size": "1000",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().libraryVariables.ModuleInstanceIdColumnName",
                    "type": "Expression"
                  }
                },
                {
                  "name": "DefaultStartValue",
                  "type": "String",
                  "size": "100",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().libraryVariables.DefaultStartValue",
                    "type": "Expression"
                  }
                },
                {
                  "name": "ConsistencyModuleTypeList",
                  "type": "String",
                  "size": "4000",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().libraryVariables.ConsistencyModuleTypeList",
                    "type": "Expression"
                  }
                },
                {
                  "name": "SourceTimestampColumn",
                  "type": "String",
                  "size": "128",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().libraryVariables.SourceTimestampColumn",
                    "type": "Expression"
                  }
                }
              ]
            }
          ]
        },
        "description": "Creates and evaluates the project Batch Instance; returns its own Modules and the child Batches."
      },
